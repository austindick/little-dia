{
  "manifest_version": 3,
  "name": "Lil Brow Wow",
  "version": "0.1.0",
  "description": "Opens links from other apps in a little window on the desktop you're on.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "webNavigation",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "click-rules.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "copy-url": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Copy page URL"
    },
    "move-to-main": {
      "suggested_key": {
        "default": "Alt+Shift+O",
        "mac": "Alt+Command+O"
      },
      "description": "Move little window to main window"
    }
  }
}
